<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-yellow-500 to-indigo-600 p-8 text-white font-sans">

<header class="absolute top-4 right-4 text-right text-sm opacity-100">
  <p class="font-bold">Victor Esquivel Fere</p>
  <p>TC2005B - Lab 13</p>
</header>

<main class="mt-20">

<h1 class="text-5xl font-extrabold mb-6 drop-shadow-lg">
Peleadores UFC
</h1>

<section class="bg-white/20 backdrop-blur-md p-7 rounded-xl border border-indigo-300/30 shadow-2xl">

<a href="/peleadores/new">
<button class="bg-indigo-500 px-4 py-2 rounded-lg">
Agregar Peleador
</button>
</a>

<br><br>

<div class="grid grid-cols-3 gap-6">

<% for (let peleador of peleadores) { %>

<div class="bg-black/30 p-4 rounded-lg">

<h2 class="text-xl font-bold"><%= peleador.nombre %></h2>

<p class="text-sm opacity-80">
División: <%= peleador.division %>
</p>

<img src="<%= peleador.imagen %>" class="mt-3 rounded-lg">

</div>

<% } %>

</div>

</section>

</main>

</body>
</html>