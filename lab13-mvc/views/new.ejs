<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-yellow-500 to-indigo-600 p-8 text-white font-sans">

<header class="absolute top-4 right-4 text-right text-sm opacity-100">
  <p class="font-bold">Victor Esquivel Fere</p>
  <p>TC2005B - Lab 13</p>
</header>

<main class="mt-20">

<h1 class="text-5xl font-extrabold mb-6 drop-shadow-lg">
Agregar Peleador UFC
</h1>

<section class="bg-white/20 backdrop-blur-md p-7 rounded-xl border border-indigo-300/30 shadow-2xl">

<form action="/peleadores/new" method="POST" class="space-y-4">

<div>
  <label class="block text-lg mb-1">Nombre</label>
  <input type="text" name="nombre" class="w-full p-2 rounded text-black" required>
</div>

<div>
  <label class="block text-lg mb-1">Imagen</label>
  <input type="text" name="imagen" class="w-full p-2 rounded text-black" required>
</div>

<div>
  <label class="block text-lg mb-1">División</label>
  <input type="text" name="division" class="w-full p-2 rounded text-black" required>
</div>

<button class="bg-indigo-500 px-4 py-2 rounded-lg">
Guardar Peleador
</button>

</form>

</section>

</main>

</body>
</html>